# Server
PORT=4000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://gateway:password@db:5432/gateway

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# OAuth
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=https://api.wraithprotocol.xyz/auth/google/callback

GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_CALLBACK_URL=https://api.wraithprotocol.xyz/auth/github/callback

# Stripe
STRIPE_SECRET_KEY=sk_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_xxx

# Spectre (TEE)
SPECTRE_INTERNAL_URL=https://spectre-internal.wraith.dev
GATEWAY_SPECTRE_SECRET=shared-secret-between-gateway-and-spectre

# Console
CONSOLE_URL=https://console.wraithprotocol.xyz

# Email (for password reset, invites)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxx
EMAIL_FROM=noreply@wraithprotocol.xyz
